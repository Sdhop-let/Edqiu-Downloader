# ===== 本机环境配置（含路径，不入库） =====
local.properties

# ===== 签名密钥（敏感，切勿提交） =====
keystore.jks
keystore.properties
*.keystore
*.jks

# ===== 本地调试 / 中间产物目录 =====
tmp_adb_db/
audit-ui-auto/
snackbar-fix-compare/
.trae-html-share-packages/

# ===== tools/build_iter.sh 构建时「让位」的旧目录 =====
# 脚本每轮会把 .gradle / app/build 改名成 <名>_iter<编号>（build_push.sh 早期版本为 _prev<时间戳>），
# 不忽略的话每次构建都会在 git status 里冒出两个未跟踪目录
.gradle_iter*/
app/build_iter*/
.gradle_prev*/
app/build_prev*/

